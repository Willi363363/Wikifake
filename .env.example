# Monorepo configuration. Copy to `.env.local` and fill in the values.
# `.env` is still read as a fallback; a variable already exported in the shell
# beats both, which is how CI and production stay unaffected by these files.
# The schema of record is packages/env/src/index.ts: any variable added here
# must be declared there, otherwise it is silently ignored.

NODE_ENV=development
LOG_LEVEL=debug

# Postgres (Neon in production) — phase 2
# The role is `postgres`: the container in plans/current-state/07-local-setup.md
# creates a database named `wikifake`, not a role of that name.
DATABASE_URL=postgres://postgres:wikifake@localhost:5432/wikifake

# Redis (Upstash in production) — phases 3 and 5
REDIS_URL=redis://localhost:6379

# Language model (Google AI Studio) — phase 3
GOOGLE_GENERATIVE_AI_API_KEY=your_key_here
MODEL_NAME=gemini-3.1-flash-lite

# Better Auth — phase 4
# The secret signs every session cookie: at least 32 characters, and generated
# rather than chosen. `openssl rand -base64 32` will do.
BETTER_AUTH_SECRET=your_32_character_secret_goes_here
# Where this deployment answers. Every OAuth redirect URI is built from it, and
# the default below is right on a laptop and silent everywhere else: a deployed
# environment that leaves it at localhost sends every player who signs in to
# their own machine. `assertCallbackReachable` refuses that combination once a
# provider is configured — see plans/product/05-accounts-oauth.md.
BETTER_AUTH_URL=http://localhost:3000

# Realtime service — phase 5
# Which origins may open a WebSocket. Comma-separated. Optional: the service
# falls back to BETTER_AUTH_URL, because the web app is the only legitimate
# origin. The list is for preview deployments and a second domain.
# REALTIME_ALLOWED_ORIGINS=https://wikifake.example,https://preview.wikifake.example

# Social sign-in — optional, both halves or neither. A provider with no
# credentials is simply not offered; the game stays playable without any.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/<provider>
# GOOGLE_OAUTH_CLIENT_ID=your_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# GITHUB_OAUTH_CLIENT_ID=your_client_id
# GITHUB_OAUTH_CLIENT_SECRET=your_client_secret

# The quest cron's bearer token — step F.5. Vercel sets and sends this itself in
# production; locally it is only needed to call /api/cron/quests by hand, since
# the read path assigns a missing set anyway. Unset, the route refuses every
# request rather than running open.
# CRON_SECRET=a_long_random_token

# Where the browser opens its room socket, from step 7.1.
#
# The app and the realtime service are two deployments — Vercel and Fly — so the
# browser needs the second one's address. Locally they are two ports, so the
# value below is the one a room needs — the same one apps/e2e uses. Left empty,
# the client falls back to the page's own host, which is :3000 locally, where
# nothing listens: the room would simply never connect.
#
# `NEXT_PUBLIC_` because it is inlined into the bundle at build time: it is not a
# secret, and it cannot be one — everybody who loads the page can read it.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080
