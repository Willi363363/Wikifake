# Copiez ce fichier en `.env` puis renseignez votre cle.
# `make build` le cree automatiquement s'il est absent.

# --- Obligatoire ----------------------------------------------------------
# Cle API OpenAI : sans elle, la generation d'articles echoue proprement
# (le reste de l'application fonctionne).
OPENAI_API_KEY=

# --- Serveur (optionnel) --------------------------------------------------
# WIKIFAKE_HOST=0.0.0.0
# WIKIFAKE_PORT=8000
# WIKIFAKE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- Generation (optionnel) ----------------------------------------------
# WIKIFAKE_MODEL=gpt-4o-mini
# WIKIFAKE_WIKI_LANG=fr
# WIKIFAKE_FAKES=4                 # fausses infos par article
# WIKIFAKE_MIN_PARAGRAPH_CHARS=100 # longueur minimale d'un paragraphe jouable
# WIKIFAKE_MAX_ATTEMPTS=6          # tentatives avant abandon (borne le cout LLM)
# WIKIFAKE_HTTP_TIMEOUT=15

# --- Parties (optionnel) -------------------------------------------------
# WIKIFAKE_DURATION=180            # duree par defaut, en secondes
# WIKIFAKE_MIN_DURATION=30
# WIKIFAKE_MAX_DURATION=600
# WIKIFAKE_MAX_PLAYERS=8
# WIKIFAKE_ITEM_INTERVAL=30        # secondes entre deux distributions d'items
# WIKIFAKE_ROOM_TTL=900            # duree de vie d'une salle vide

# --- Score (optionnel) ---------------------------------------------------
# WIKIFAKE_PTS_HIT=150
# WIKIFAKE_PTS_FALSE_POS=80
# WIKIFAKE_PTS_TIME=0.5
# WIKIFAKE_PTS_HINT=50
# WIKIFAKE_PTS_REVEAL_FACTOR=4

# --- Garde-fous (optionnel) ---------------------------------------------
# WIKIFAKE_RATELIMIT=1
# WIKIFAKE_RATELIMIT_CALLS=10
# WIKIFAKE_RATELIMIT_WINDOW=60
