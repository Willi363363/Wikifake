# Configuration du monorepo. Copiez en `.env` et renseignez les valeurs.
# Le schéma qui fait foi est packages/env/src/index.ts : toute variable ajoutée
# ici doit y être déclarée, sinon elle est ignorée en silence.

NODE_ENV=development
LOG_LEVEL=debug

# Postgres (Neon en production) — phase 2
DATABASE_URL=postgres://wikifake:wikifake@localhost:5432/wikifake

# Redis (Upstash en production) — phases 3 et 5
REDIS_URL=redis://localhost:6379

# Modèle de langage (Google AI Studio) — phase 3
GOOGLE_GENERATIVE_AI_API_KEY=votre_cle_ici
MODEL_NAME=gemini-3.1-flash-lite
