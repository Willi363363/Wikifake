    "migrate": "drizzle-kit migrate",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@wikifake/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@wikifake/env": "workspace:*",
    "@wikifake/protocol": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
