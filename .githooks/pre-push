#!/usr/bin/env bash
# Last line of defence before the remote: no direct push to main or staging,
# no rewriting of shared history. The real lock is on the GitHub side (the
# ruleset) — this one only prevents the accident, and says so.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  target=${remote_ref#refs/heads/}

  if ! bash scripts/checks.sh push "$target"; then
    status=1
    continue
  fi

  # A non-fast-forward push rewrites history that was already published.
  if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      printf '  \033[33m!\033[0m %s: non-fast-forward push (history rewrite)\n' "$target" >&2
      printf '    Acceptable on your own branch, never on a shared one.\n' >&2
    fi
  fi
done

if [ "$status" -ne 0 ]; then
  printf '\n\033[31mPush rejected.\033[0m Open a pull request.\n' >&2
  exit 1
fi
