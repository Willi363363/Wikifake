#!/usr/bin/env bash
# Dernier rempart avant le distant : aucun push direct sur une branche protégée,
# aucune réécriture d'historique partagé. Le vrai verrou est côté GitHub
# (branch protection) — celui-ci évite juste l'accident, et le rappelle.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  target=${remote_ref#refs/heads/}

  if ! bash scripts/checks.sh push "$target"; then
    status=1
    continue
  fi

  # Push non fast-forward = réécriture d'un historique déjà publié.
  if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      printf '  \033[33m!\033[0m %s : push non fast-forward (réécriture d'\''historique)\n' "$target" >&2
      printf '    Acceptable sur votre branche de travail, jamais sur une branche partagée.\n' >&2
    fi
  fi
done

if [ "$status" -ne 0 ]; then
  printf '\n\033[31mPush refusé.\033[0m Ouvrez une pull request.\n' >&2
  exit 1
fi
