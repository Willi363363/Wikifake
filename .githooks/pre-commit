#!/usr/bin/env bash
# Fast checks before every commit. The rules live in
# plans/method/02-repository-rules.md, their implementation in
# scripts/checks.sh (shared with CI).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
printf '\033[1mpre-commit\033[0m\n'
if ! bash scripts/checks.sh staged; then
  printf '\n\033[31mCommit rejected.\033[0m Fix the above, or justify it in the PR.\n' >&2
  printf 'Bypass: git commit --no-verify — traced, and caught by CI.\n' >&2
  exit 1
fi
printf '\033[32mok\033[0m\n'
