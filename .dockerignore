# Contexte de build minimal : rien de local ne doit se retrouver dans l'image.
.git
.github
venv
.venv
__pycache__/
*.pyc
*.md

# Le frontend est recompilé dans le stage Node — jamais copié depuis le disque.
frontend/node_modules
frontend/dist
frontend/.smoke

# Secrets et données runtime
.env
data/
backend/data/
